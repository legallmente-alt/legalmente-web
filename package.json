{
  "name": "legalmente-web",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio web de LegalMente - divulgacion juridica panhispanica.",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "build:public": "NODE_ENV=production npm run build && node scripts/prepare-public-pages.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:legal-core": "tsx --test src/lib/legal-core/legal-core.test.ts",
    "test:knowledge-safety": "tsx --test src/lib/knowledge-graph/safety.test.ts",
    "test:public-routes": "node scripts/public-route-proof.mjs"
  },
  "dependencies": {
    "next": "^15.5.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.4",
    "tsx": "4.20.5",
    "typescript": "^5.5.2"
  }
}
