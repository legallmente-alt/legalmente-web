{
  "name": "legalmente-web",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio web de LegalMente - divulgacion juridica panhispanica.",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "build:public": "NODE_ENV=production npm run build && node scripts/prepare-public-pages.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:legal-core": "tsx --test src/lib/legal-core/legal-core.test.ts",
    "test:knowledge-safety": "tsx --test src/lib/knowledge-graph/safety.test.ts",
    "test:knowledge-integrity": "tsx --test src/lib/knowledge-graph/integrity.test.ts",
    "test:ecosystem-kernel": "tsx --test src/lib/ecosystem-kernel/index.test.ts",
    "test:agent-contribution": "tsx --test src/lib/agent-contribution/contract.test.ts",
    "test:editorial-engine": "tsx --test src/lib/editorial-engine/*.test.ts",
    "test:production-policy": "node --import tsx --test src/lib/production-policy/*.test.ts",
    "test:visual-factory": "node --import tsx --test src/lib/visual-factory/*.test.ts",
    "test:production-learning": "node --import tsx --test src/lib/production-learning/*.test.ts",
    "test:production-runtime": "node --import tsx --test src/lib/production-runtime/*.test.ts",
    "test:release-readiness": "node --import tsx --test src/lib/release-readiness/*.test.ts",
    "test:convergence": "npm run test:production-policy && npm run test:visual-factory && npm run test:production-learning && npm run test:production-runtime && npm run test:release-readiness",
    "test:knowledge-pilot": "tsx --test src/lib/knowledge-pilot/*.test.ts",
    "test:opportunity-engine": "tsx --test src/lib/opportunity-engine/*.test.ts",
    "test:public-routes": "node scripts/public-route-proof.mjs",
    "test:legal-surface": "node scripts/legal-surface-smoke.mjs",
    "test:social-content": "node scripts/social-content-contract-smoke.mjs",
    "test:release-integration": "npm run test:convergence && npm run build:public && npm run test:legal-surface && npm run test:social-content",
    "release:status": "node --import tsx scripts/release-readiness-status.ts"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "4.20.5",
    "typescript": "^5.5.2"
  }
}
